{
 "id": "discord.post_text",
 "version": 1,
 "platform": "discord",
 "description": "Create and publish a text post in Discord. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "open_app",
   "package": "com.discord"
  },
  {
   "op": "tap",
   "labels": [
    "Home"
   ],
   "optional": true,
   "timeout_s": 6
  },
  {
   "op": "tap",
   "labels": [
    "Message"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Message",
    "Message #"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
