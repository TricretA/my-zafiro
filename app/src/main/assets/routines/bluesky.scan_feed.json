{
 "id": "bluesky.scan_feed",
 "version": 1,
 "platform": "bluesky",
 "description": "Scroll the Bluesky feed and collect post texts to judge for engagement.",
 "params": [],
 "steps": [
  {
   "op": "open_app",
   "package": "xyz.blueskyweb.app"
  },
  {
   "op": "tap",
   "labels": [
    "Home"
   ],
   "optional": true,
   "timeout_s": 6
  },
  {
   "op": "tap",
   "labels": [
    "Discover",
    "Following"
   ],
   "optional": true
  },
  {
   "op": "sleep",
   "ms": 1200
  },
  {
   "op": "collect",
   "count": 5
  }
 ]
}
