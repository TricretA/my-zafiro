{
 "id": "messenger.comment",
 "version": 1,
 "platform": "messenger",
 "description": "On the post (or chat) currently open in Messenger, write a comment or reply and send it. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "tap",
   "labels": [
    "Reply"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Message",
    "Aa"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
