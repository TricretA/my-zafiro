{
 "id": "bluesky.read_activity",
 "version": 1,
 "platform": "bluesky",
 "description": "Open Bluesky notifications/activity and return what is shown (replies, likes, mentions).",
 "params": [],
 "steps": [
  {
   "op": "open_app",
   "package": "xyz.blueskyweb.app"
  },
  {
   "op": "tap",
   "labels": [
    "Notifications"
   ],
   "optional": true
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "collect",
   "count": 3
  }
 ]
}
