{
 "id": "tumblr.read_activity",
 "version": 1,
 "platform": "tumblr",
 "description": "Open Tumblr notifications/activity and return what is shown (replies, likes, mentions).",
 "params": [],
 "steps": [
  {
   "op": "open_app",
   "package": "com.tumblr"
  },
  {
   "op": "tap",
   "labels": [
    "Activity"
   ],
   "optional": true
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "collect",
   "count": 3
  }
 ]
}
