{
 "id": "twitch.scan_feed",
 "version": 1,
 "platform": "twitch",
 "description": "Scroll the Twitch feed and collect post texts to judge for engagement.",
 "params": [],
 "steps": [
  {
   "op": "open_app",
   "package": "tv.twitch.android.app"
  },
  {
   "op": "tap",
   "labels": [
    "Home"
   ],
   "optional": true,
   "timeout_s": 6
  },
  {
   "op": "tap",
   "labels": [
    "Following",
    "Browse"
   ],
   "optional": true
  },
  {
   "op": "sleep",
   "ms": 1200
  },
  {
   "op": "collect",
   "count": 5
  }
 ]
}
