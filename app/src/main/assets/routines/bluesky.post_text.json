{
 "id": "bluesky.post_text",
 "version": 1,
 "platform": "bluesky",
 "description": "Create and publish a text post in Bluesky. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "open_app",
   "package": "xyz.blueskyweb.app"
  },
  {
   "op": "tap",
   "labels": [
    "Home"
   ],
   "optional": true,
   "timeout_s": 6
  },
  {
   "op": "tap",
   "labels": [
    "New post",
    "Compose"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "What's up?",
    "Write your reply"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Post"
   ],
   "timeout_s": 8
  }
 ]
}
