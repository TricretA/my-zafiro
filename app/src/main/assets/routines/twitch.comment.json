{
 "id": "twitch.comment",
 "version": 1,
 "platform": "twitch",
 "description": "On the post (or chat) currently open in Twitch, write a comment or reply and send it. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "tap",
   "labels": [
    "Send a message",
    "Chat"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Send a message",
    "Chat"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Chat",
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
